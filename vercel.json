{
  "headers": [
    {
      "source": "/service-areas/(.*\\.md)",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!service-areas/).*)",
      "destination": "/index.html"
    }
  ]
}
